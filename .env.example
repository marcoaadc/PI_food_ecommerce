# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="mysql://root:your_password@localhost:3306/burguer_house"

# JWT
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# File Uploads
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=5242880

# CORS
FRONTEND_URL=http://localhost:5173

# Seed (opcional em dev, obrigatorio em ambientes com dados sensiveis)
SEED_ADMIN_PASSWORD=your-admin-password
SEED_CUSTOMER_PASSWORD=your-customer-password
